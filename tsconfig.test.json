{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable", "WebWorker"],
    "allowJs": false,
    "checkJs": false,
    "noEmit": true,
    "types": ["node"]
  },
  "include": [
    "test/**/*.ts",
    "scripts/**/*.d.mts",
    "src/renderer/platform/window.d.ts"
  ]
}
