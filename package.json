{
  "name": "mdeditor",
  "productName": "MD Editor",
  "version": "0.0.1",
  "private": true,
  "description": "Fast, stable Markdown editor with live preview",
  "main": "dist/main/main.js",
  "license": "GPL-3.0-or-later",
  "scripts": {
    "build": "tsc -p tsconfig.main.json && vite build",
    "typecheck": "tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.renderer.json --noEmit",
    "test:unit": "vitest run --coverage",
    "test:e2e": "npm run build && node scripts/run-e2e.cjs",
    "check:acceptance": "node scripts/check-acceptance.mjs",
    "check:coverage": "node scripts/check-coverage-ratchet.mjs",
    "verify": "npm run typecheck && npm run test:unit && npm run test:e2e && npm run check:acceptance",
    "start": "npm run build && electron ."
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/jsdom": "30.0.0",
    "@types/markdown-it": "14.2.0",
    "@types/node": "24.19.2",
    "@vitest/coverage-v8": "5.1.0",
    "electron": "45.2.1",
    "electron-builder": "26.18.0",
    "jsdom": "30.1.3",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  },
  "dependencies": {
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/theme-one-dark": "6.1.3",
    "codemirror": "6.0.2",
    "dompurify": "3.4.17",
    "highlight.js": "11.12.0",
    "markdown-it": "15.0.3"
  }
}
